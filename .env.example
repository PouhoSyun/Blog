# 本地开发；上线必须按 README 改为 production / HTTPS。
NODE_ENV=development
HOST=127.0.0.1
PORT=4180
TZ=Asia/Shanghai
BLOG_SITE_ORIGIN=http://localhost:4180
BLOG_ADMIN_USER=admin
# npm run password 生成；设置 hash 后优先于明文口令。
BLOG_ADMIN_PASSWORD_HASH=
# 仅本地临时开发使用；正式环境删除此项，使用 hash。
BLOG_ADMIN_PASSWORD=replace-this-local-password
# npm run totp 生成；保存到验证器后填写 Base32 secret。
BLOG_ADMIN_TOTP_SECRET=
BLOG_COOKIE_SECURE=0
# 无代理直连时必须关闭；仅部署在可信 Nginx 后时设为 1。
BLOG_TRUST_PROXY=0
BLOG_DATA_FILE=data/blog.json
BLOG_UPLOAD_DIR=uploads
BLOG_PAGE_SIZE=8
